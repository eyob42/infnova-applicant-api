generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum InternshipTrack {
  FRONTEND_DEVELOPMENT
  BACKEND_DEVELOPMENT
  MOBILE_DEVELOPMENT
  UI_UX_DESIGN
  DATA_ANALYTICS
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Applicant {
  id        Int               @id @default(autoincrement())
  name      String
  email     String            @unique
  track     InternshipTrack
  status    ApplicationStatus @default(PENDING)
  notes     String?
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([track])
  @@index([deletedAt])
}
